# ---------------------------------------------------------------- Supabase
# Powers the admin login, blog, media uploads, editable site copy, and the
# inquiries inbox. Leave these unset and the site still runs — it falls back
# to the static content in content/site.ts, and /admin is unreachable.
#
# Find these in Supabase: Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security so the public forms can record
# submissions the anon role can't read. NEVER prefix this with NEXT_PUBLIC_
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Email
# Optional. Without these, submissions are still saved — the notification
# email is just skipped and a warning is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=jaychukwu18@gmail.com
